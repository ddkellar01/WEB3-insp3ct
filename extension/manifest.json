{
  "manifest_version": 3,
  "name": "WEB3-insp3ct",
  "version": "1.0.0",
  "description": "Inspect DOM trees, network traffic, and Web3 RPC calls live.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "webNavigation"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": "icons/icon-48.png"
  },
  "devtools_page": "devtools/devtools.html"
}
